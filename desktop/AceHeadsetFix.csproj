<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>AceHeadsetFix</AssemblyName>
    <RootNamespace>AceHeadsetFix</RootNamespace>
    <Version>1.2.0</Version>
    <Authors>AceXR</Authors>
    <Product>Ace Headset Fix</Product>
    <ApplicationIcon>AceHeadsetFix.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;publish/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\logo-white.png" LogicalName="logo-white.png" />
    <EmbeddedResource Include="Assets\guide\allow-usb-debugging.jpg" LogicalName="guide.allow-usb-debugging.jpg" />
  </ItemGroup>

</Project>
